{
  "name": "APEX QR Scanner Plugin",
  "version": "1.0.0",
  "description": "Scan QR codes with the device camera inside an APEX page. Writes the decoded text, URL or number into a page item, fires a custom qr-scanned event for Dynamic Actions, supports rear/front camera and stop after first scan. Runs fully in the browser with no external server or CDN. Uses the jsQR library (Apache-2.0) by Cosmo Wolfe.",
  "keywords": ["qr", "qr code", "scanner", "camera", "barcode", "jsqr", "attendance", "mobile"],
